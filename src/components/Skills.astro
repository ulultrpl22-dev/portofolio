---
import { skills, type Lang } from '../content/site';
import { tr, useUi } from '../i18n';
import SectionHead from './SectionHead.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useUi(lang);
// Variasi gaya & kemiringan supaya terasa "ditempel tangan", tapi tetap deterministik
const styles = ['fill', 'line', 'soft', 'line', 'accent', 'line'];
const tilts = [-1, 0.8, -0.5, 1, -0.8, 0.5, -0.3, 0.7];
---

<section class="skills" id="skills" aria-labelledby="skills-title">
  <div class="container">
    <SectionHead num="04" label={t.sections.skills} title={t.skills.title} id="skills-title" intro={t.skills.intro} align="split" />

    <div class="skills__groups" data-stagger>
      {
        skills.map((g, gi) => (
          <div class="sgroup">
            <h3 class="sgroup__name serif">
              <span class="sgroup__num">0{gi + 1}</span>
              {tr(g.group, lang)}
            </h3>
            <ul class="sgroup__chips" role="list" data-chips>
              {g.items.map((item, i) => (
                <li
                  class:list={['bigchip', `bigchip--${styles[(i + gi) % styles.length]}`]}
                  style={`--r:${tilts[(i * 3 + gi) % tilts.length]}deg`}
                >
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills {
    padding-block: var(--section-y);
  }
  .skills__groups {
    display: grid;
  }
  .sgroup {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(1.25rem, 3vw, 2rem);
    border-top: 1px solid var(--line);
  }
  .sgroup:last-child {
    border-bottom: 1px solid var(--line);
  }
  .sgroup__name {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: var(--fs-h3);
    font-weight: 400;
    font-style: italic;
  }
  .sgroup__num {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: var(--fs-micro);
    color: var(--ink-3);
  }
  .sgroup__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 0.7rem;
    padding: 0;
  }
  .bigchip {
    display: inline-flex;
    align-items: center;
    padding: 0.5em 1.05em;
    border-radius: var(--r-pill);
    font-size: clamp(0.95rem, 1.25vw, 1.15rem);
    font-weight: 500;
    line-height: 1.2;
    rotate: var(--r);
    transition: rotate 0.5s var(--ease-spring), scale 0.5s var(--ease-spring), background 0.3s, color 0.3s;
    cursor: default;
  }
  .bigchip--fill {
    background: var(--ink);
    color: var(--bg);
  }
  .bigchip--line {
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }
  .bigchip--soft {
    background: var(--accent-soft);
    color: var(--ink);
  }
  .bigchip--accent {
    background: var(--accent);
    color: var(--on-accent);
  }
  .bigchip:hover {
    rotate: 0deg;
    scale: 1.06;
    background: var(--accent);
    color: var(--on-accent);
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 64rem) {
    .sgroup {
      grid-template-columns: 18rem 1fr;
      align-items: center;
    }
  }
</style>
