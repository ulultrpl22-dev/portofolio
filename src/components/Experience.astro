---
import { experience, type Lang } from '../content/site';
import { tr, useUi } from '../i18n';
import SectionHead from './SectionHead.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useUi(lang);
---

<section class="exp" id="experience" aria-labelledby="exp-title">
  <div class="container">
    <SectionHead num="03" label={t.sections.experience} title={t.experience.title} id="exp-title" intro={t.experience.intro} align="split" />

    <ol class="timeline" role="list" data-timeline>
      <span class="timeline__rail" aria-hidden="true"><span class="timeline__progress" data-timeline-progress></span></span>
      {
        experience.map((e, i) => (
          <li class="tl-item" data-tl-item>
            <span class="tl-item__dot" aria-hidden="true" />
            <p class="tl-item__period">{tr(e.period, lang)}</p>
            <div class="tl-item__card">
              <h3 class="tl-item__role serif">{tr(e.role, lang)}</h3>
              <p class="tl-item__org">
                <strong>{e.org}</strong>
                <span aria-hidden="true"> · </span>
                {tr(e.place, lang)}
              </p>
              <ul class="tl-item__points" role="list">
                {e.points.map((pt) => (
                  <li>{tr(pt, lang)}</li>
                ))}
              </ul>
              {i === 0 && <span class="sticker tl-item__now" style="--tilt:5deg">{t.experience.now}</span>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .exp {
    padding-block: var(--section-y);
  }
  .timeline {
    --rail-x: 0.6rem;
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    padding: 0 0 0 2.75rem;
    list-style: none;
  }
  .timeline__rail {
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: var(--rail-x);
    width: 2px;
    border-radius: 2px;
    background: var(--line);
    overflow: hidden;
  }
  .timeline__progress {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--accent), var(--accent-deco));
    transform-origin: top;
    transform: scaleY(1);
  }
  :global(html.js) .timeline__progress {
    transform: scaleY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .timeline__progress {
      transform: scaleY(1);
    }
  }

  .tl-item {
    position: relative;
    display: grid;
    gap: 0.75rem;
  }
  .tl-item__dot {
    position: absolute;
    top: 0.3rem;
    left: calc(var(--rail-x) - 2.75rem - 0.45rem + 1px);
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: inset 0 0 0 2px var(--line);
    transition: background 0.5s var(--ease-out), box-shadow 0.5s, scale 0.6s var(--ease-spring);
  }
  .tl-item.is-active .tl-item__dot,
  :global(html:not(.js)) .tl-item__dot {
    background: var(--accent);
    box-shadow: 0 0 0 6px color-mix(in oklab, var(--accent) 22%, transparent);
    scale: 1.15;
  }
  .tl-item__period {
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--accent);
  }
  .tl-item__card {
    position: relative;
    display: grid;
    gap: 0.6rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: var(--shadow-md), inset 0 0 0 1px var(--line);
    transition: translate 0.6s var(--ease-out), box-shadow 0.6s;
  }
  .tl-item__card:hover {
    translate: 0 -4px;
    box-shadow: var(--shadow-lg), inset 0 0 0 1px var(--line);
  }
  .tl-item__role {
    font-size: var(--fs-h3);
    font-weight: 400;
    line-height: 1.1;
  }
  .tl-item__org {
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
  .tl-item__org strong {
    color: var(--ink);
    font-weight: 600;
  }
  .tl-item__points {
    display: grid;
    gap: 0.6rem;
    margin-top: 0.5rem;
    padding: 0;
  }
  .tl-item__points li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink-2);
    max-width: 60ch;
  }
  .tl-item__points li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
  .tl-item__now {
    position: absolute;
    top: -0.9rem;
    right: 1rem;
  }

  @media (min-width: 64rem) {
    .timeline {
      --rail-x: 14.75rem;
      padding-left: 0;
    }
    .tl-item {
      grid-template-columns: 12rem 1fr;
      column-gap: 5.5rem;
    }
    .tl-item__period {
      padding-top: 0.15rem;
      text-align: right;
    }
    .tl-item__dot {
      left: calc(var(--rail-x) - 0.45rem + 1px);
    }
  }
</style>
