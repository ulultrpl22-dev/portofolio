---
import { beyond, type Lang } from '../content/site';
import { tr, useUi } from '../i18n';
import SectionHead from './SectionHead.astro';
import { Image } from 'astro:assets';
import { asset } from '../lib/images';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useUi(lang);
const tilts = [-6, 4, -3, 7];
---

<section class="beyond" id="beyond" aria-labelledby="beyond-title">
  <div class="container">
    <SectionHead num="06" label={t.sections.beyond} title={t.beyond.title} id="beyond-title" intro={t.beyond.intro} align="split" />

    <ul class="polaroids" role="list" data-polaroids>
      {
        beyond.map((b, i) => (
          <li class="polaroid" style={`--tilt:${tilts[i % tilts.length]}deg; --i:${i}`}>
            <span class="polaroid__tape" aria-hidden="true" />
            <div class:list={['polaroid__photo', `polaroid__photo--${i % 4}`]}>
              {asset(b.photo) ? (
                <Image src={asset(b.photo)!} alt={tr(b.title, lang)} widths={[280, 420, 560]} sizes="(min-width: 48rem) 22vw, 45vw" loading="lazy" />
              ) : (
                <span aria-hidden="true">{b.emoji}</span>
              )}
            </div>
            <p class="polaroid__title serif">{tr(b.title, lang)}</p>
            <p class="polaroid__note">{tr(b.note, lang)}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .beyond {
    padding-block: var(--section-y);
    overflow: clip;
  }
  .polaroids {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem 1rem;
    padding: 1rem 0 0;
  }
  .polaroid {
    position: relative;
    display: grid;
    gap: 0.4rem;
    padding: 0.6rem 0.6rem 1rem;
    border-radius: 0.4rem;
    background: #fbfcfe;
    color: #0d1526;
    box-shadow: var(--shadow-lg);
    rotate: var(--tilt);
    transition: rotate 0.6s var(--ease-spring), scale 0.6s var(--ease-spring), translate 0.6s var(--ease-spring);
  }
  :global([data-theme='dark']) .polaroid {
    background: #e9eef7;
  }
  .polaroid:hover {
    rotate: 0deg;
    scale: 1.06;
    translate: 0 -0.5rem;
    z-index: 2;
  }
  .polaroid__tape {
    position: absolute;
    top: -0.7rem;
    left: 50%;
    width: 4.5rem;
    height: 1.4rem;
    translate: -50% 0;
    rotate: calc(var(--tilt) * -1.5);
    background: color-mix(in oklab, var(--accent-deco) 35%, rgb(255 255 255 / 0.55));
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }
  .polaroid__photo {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 0.2rem;
    overflow: hidden;
  }
  .polaroid__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
    filter: saturate(0.9) contrast(1.02);
    transition: scale 0.8s var(--ease-out);
  }
  .polaroid:hover .polaroid__photo :global(img) {
    scale: 1.06;
  }
  .polaroid__photo span {
    font-size: clamp(2.75rem, 9vw, 4.5rem);
    transition: scale 0.6s var(--ease-spring), rotate 0.6s var(--ease-spring);
  }
  .polaroid:hover .polaroid__photo span {
    scale: 1.2;
    rotate: -10deg;
  }
  .polaroid__photo--0 { background: linear-gradient(140deg, #c9d8f5, #8fb2f0); }
  .polaroid__photo--1 { background: linear-gradient(140deg, #dfe7f3, #b7c6de); }
  .polaroid__photo--2 { background: linear-gradient(140deg, #9db9f2, #3d7bff); }
  .polaroid__photo--3 { background: linear-gradient(140deg, #1b2b4d, #3a4f80); }
  .polaroid__title {
    margin-top: 0.4rem;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-style: italic;
    line-height: 1.15;
  }
  .polaroid__note {
    font-size: var(--fs-small);
    color: #3a4660;
    line-height: 1.4;
  }

  @media (min-width: 48rem) {
    .polaroids {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.5rem;
    }
    .polaroid:nth-child(even) {
      margin-top: 3rem;
    }
    .polaroid {
      padding: 0.85rem 0.85rem 1.4rem;
    }
  }
</style>
